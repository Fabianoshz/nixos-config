+// The Steam Deck's own UI space, used only as a fallback when the live size of
+// the Steam window can't be read.
+export const DEFAULT_SCREEN_WIDTH = 854;
+export const DEFAULT_SCREEN_HEIGHT = 534;
+
 export const MARGIN = 20;
-export const PICTURE_WIDTH = SCREEN_WIDTH * 0.4;
-export const PICTURE_HEIGHT = PICTURE_WIDTH * (1.0 / 1.85);
+
+const PICTURE_WIDTH_RATIO = 0.4;
+const PICTURE_ASPECT_RATIO = 1.85;
+
+// Height the virtual keyboard covers on a Deck, kept as a ratio so it scales to
+// whatever the screen actually is.
+const VIRTUAL_KEYBOARD_HEIGHT_RATIO = 240 / DEFAULT_SCREEN_HEIGHT;
+
+export interface Size {
+    width: number
+    height: number
+}
+
+const getMainWindowInstance = (): any =>
+    (window as any).SteamUIStore?.WindowStore?.GamepadUIMainWindowInstance;
+
+// Steam's UI space is 854x534 on Deck hardware, but on anything else (a Steam
+// Machine on a TV, an external monitor, Big Picture on a desktop) it is
+// whatever the display dictates, so read it live rather than assuming.
+export const getScreenSize = (): Size => {
+    const browserWindow = getMainWindowInstance()?.m_BrowserWindow;
+    const width = browserWindow?.innerWidth;
+    const height = browserWindow?.innerHeight;
+
+    return width > 0 && height > 0
+        ? { width, height }
+        : { width: DEFAULT_SCREEN_WIDTH, height: DEFAULT_SCREEN_HEIGHT };
+}
+
+export const getPictureSize = (screen: Size): Size => {
+    const width = screen.width * PICTURE_WIDTH_RATIO;
+
+    return { width, height: width / PICTURE_ASPECT_RATIO };
+}
+
+export const getVirtualKeyboardHeight = (screen: Size) =>
+    screen.height * VIRTUAL_KEYBOARD_HEIGHT_RATIO;
+
+// 'virtual keyboard' navigation trees are left behind on the main window after
+// the keyboard closes, so their presence says nothing about whether it is up.
+export const isVirtualKeyboardVisible = () =>
+    getMainWindowInstance()?.m_VirtualKeyboardManager
+        ?.IsShowingVirtualKeyboard?.m_currentValue === true;

 export enum ViewMode {
     Expand = 1,
