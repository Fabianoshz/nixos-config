+static void HIDAPI_DriverFlydigi_HandleInfoResponseV1(SDL_Joystick *joystick, SDL_DriverFlydigi_Context *ctx, Uint8 *data, int size)
+{
+    // Battery is reported in bars (0-5), and reads high while charging
+    Uint8 level = data[11];
+
+    if (ctx->firmware_version < 0x6400) {
+        return;
+    }
+
+    switch (data[13]) {
+    case 0:
+        SDL_SendJoystickPowerInfo(joystick, SDL_POWERSTATE_ON_BATTERY, SDL_min(level, 5) * 20);
+        break;
+    case 1:
+        SDL_SendJoystickPowerInfo(joystick, SDL_POWERSTATE_CHARGING, -1);
+        break;
+    default:
+        break;
+    }
+}
