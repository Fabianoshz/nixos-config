@@ -486,6 +500,9 @@ struct gl3_views_draw

 static void *gl3_views_create_stock(gl3_t *gl);
 static void gl3_views_sync_params(gl3_t *gl, gl3_filter_chain_t *fc);
+#ifdef HAVE_VIDEO_WINDOWS
