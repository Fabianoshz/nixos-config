{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "buildkite": {
      "type": "remote",
      "url": "https://mcp.buildkite.com/mcp"
    },
    "atlassian": {
      "command": [
        "npx",
        "-y",
        "@onyxsecurity/mcp-gateway@7398546f",
        "remote",
        "--url",
        "https://mcp.atlassian.com/v1/mcp",
        "--remote-transport",
        "stream"
      ],
      "environment": {
        "CLIENT_APP_NAME": "opencode",
        "MCP_GATEWAY_ACCESS_CONTROL_URL": "https://0gpr7rskhb.ai-guard.onyx.security/access-control/authorize",
        "MCP_GATEWAY_MIRROR_URL": "https://0gpr7rskhb.ingest.onyx.security/mcp-gateway",
        "MCP_GATEWAY_OAUTH_PROVIDERS_URL": "https://0gpr7rskhb.api.onyx.security/api/internal/extension/oauth-providers",
        "MCP_GATEWAY_SCANNER_URL": "https://0gpr7rskhb.ai-guard.onyx.security/guard/evaluate/v1"
      },
      "oauth": {},
      "type": "local"
    },
    "datadog_production": {
      "command": [
        "npx",
        "-y",
        "@onyxsecurity/mcp-gateway@7398546f",
        "remote",
        "--url",
        "https://mcp.datadoghq.com/api/unstable/mcp-server/mcp",
        "--remote-transport",
        "stream"
      ],
      "environment": {
        "CLIENT_APP_NAME": "opencode",
        "MCP_GATEWAY_ACCESS_CONTROL_URL": "https://0gpr7rskhb.ai-guard.onyx.security/access-control/authorize",
        "MCP_GATEWAY_MIRROR_URL": "https://0gpr7rskhb.ingest.onyx.security/mcp-gateway",
        "MCP_GATEWAY_OAUTH_PROVIDERS_URL": "https://0gpr7rskhb.api.onyx.security/api/internal/extension/oauth-providers",
        "MCP_GATEWAY_SCANNER_URL": "https://0gpr7rskhb.ai-guard.onyx.security/guard/evaluate/v1",
        // Separate HOME so the gateway keeps an independent OAuth store
        // (~/.onyx/mcp-gateway/oauth is keyed only by server URL).
        "HOME": "/Users/fabiano/.mcp-homes/datadog-production"
      },
      "type": "local"
    },
    "datadog_staging": {
      "command": [
        "npx",
        "-y",
        "@onyxsecurity/mcp-gateway@7398546f",
        "remote",
        "--url",
        "https://mcp.datadoghq.com/api/unstable/mcp-server/mcp",
        "--remote-transport",
        "stream"
      ],
      "environment": {
        "CLIENT_APP_NAME": "opencode",
        "MCP_GATEWAY_ACCESS_CONTROL_URL": "https://0gpr7rskhb.ai-guard.onyx.security/access-control/authorize",
        "MCP_GATEWAY_MIRROR_URL": "https://0gpr7rskhb.ingest.onyx.security/mcp-gateway",
        "MCP_GATEWAY_OAUTH_PROVIDERS_URL": "https://0gpr7rskhb.api.onyx.security/api/internal/extension/oauth-providers",
        "MCP_GATEWAY_SCANNER_URL": "https://0gpr7rskhb.ai-guard.onyx.security/guard/evaluate/v1",
        // Separate HOME so the gateway keeps an independent OAuth store
        // (~/.onyx/mcp-gateway/oauth is keyed only by server URL).
        "HOME": "/Users/fabiano/.mcp-homes/datadog-staging"
      },
      "type": "local"
    },
    "granola": {
