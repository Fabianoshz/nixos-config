    "terraform": {
      "command": [
        "npx",
        "-y",
        "@onyxsecurity/mcp-gateway@7398546f",
        "--",
        "docker",
        "run",
        "-i",
        "--rm",
        "-e",
        "TFE_TOKEN",
        "-e",
        "TFE_ADDRESS",
        "hashicorp/terraform-mcp-server:1.0.0"
      ],
      "environment": {
        "CLIENT_APP_NAME": "opencode",
        "MCP_GATEWAY_ACCESS_CONTROL_URL": "https://0gpr7rskhb.ai-guard.onyx.security/access-control/authorize",
        "MCP_GATEWAY_MIRROR_URL": "https://0gpr7rskhb.ingest.onyx.security/mcp-gateway",
        "MCP_GATEWAY_OAUTH_PROVIDERS_URL": "https://0gpr7rskhb.api.onyx.security/api/internal/extension/oauth-providers",
        "MCP_GATEWAY_SCANNER_URL": "https://0gpr7rskhb.ai-guard.onyx.security/guard/evaluate/v1",
        "TFE_ADDRESS": "{env:TFE_ADDRESS}",
        "TFE_TOKEN": "{env:TFE_TOKEN}"
      },
      "type": "local"
    }
  },
  "provider": {
    "fireworks-ai": {
      "options": {
        "baseURL": "https://ai-guard.onyx.security/c5df90ae9d94f2ee63ad0748ab0ee8bab1df0da0df7156290dafa43504f74e70/eJyqVkpJLctMTvVLzE1VslJyMXWLCDf2MDIJUdJRSs7JTM0rcSwogErmF6TmJeenpCrpKOUXK1kppSQWlWfmKekoFacWZSbm-JXmJqUWoRpSCwgAAP__1k0eeg/api.fireworks.ai/inference/v1"
      }
