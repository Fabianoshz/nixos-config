{
  "$schema": "https://opencode.ai/config.json",
  // DeepSeek V4.1 Flash: strong coding model, ~$0.15/$0.60 per M tokens.
  // Requires DEEPSEEK_API_KEY (run `opencode providers login -p deepseek`).
  "model": "deepseek/deepseek-flash",
  // GLM-4.7-Flash: genuinely free, used for cheap/low-stakes tasks
  // (title generation, summarization). Requires ZHIPU_API_KEY
  // (run `opencode providers login -p zhipuai`).
  "small_model": "zhipuai/glm-4.7-flash",
  "compaction": {
    "auto": true,
    "prune": true
  }
}
